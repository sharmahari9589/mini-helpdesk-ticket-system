{
  "name": "relay-helpdesk-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" vite.config.js index.html package.json",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" vite.config.js index.html package.json",
    "check": "npm run format:check && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "prettier": "^3.9.9"
  }
}
